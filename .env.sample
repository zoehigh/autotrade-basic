# autotrade-basic 환경변수 샘플 — 값을 채워 .env 로 복사해서 사용
# 주의: 실제 키/계좌번호는 절대 커밋 금지 (.env 는 .gitignore)

# ── 브로커 선택 ──
BROKER=toss
BROKER_MODE=real
# TOSS는 실전만 지원 (모의/demo 없음)

# ── TOSS (실전전용) ──
# TOSS_APP_KEY → client_id, TOSS_APP_SECRET → client_secret 매핑 (src/config.py)
TOSS_APP_KEY=
TOSS_APP_SECRET=
# 계좌 식별자 (Actions에서는 vars.TOSS_ACCOUNT_SEQ 로 주입)
TOSS_ACCOUNT_SEQ=

# ── KIS ──
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# ── 키움 ──
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=

# ── LS ──
LS_APP_KEY=
LS_APP_SECRET=

# ── NH나무 (NHPLUG) ──
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=
NHPLUG_ACCT_NO=

# ── 종목/시드 (TOSS는 계좌번호 불필요, 시드는 필수) ──
SYMBOLS=TQQQ:NAS,SOXL:AMS
TQQQ_SEED=
SOXL_SEED=
# TQQQ_SPLITS=20 / SOXL_SPLITS=20 (기본값, 필요시만 설정)

# ── 거래 모드 ──
# DRY(프리뷰, 무저장) | LIVE(실주문) | REPAIR(보정전용, 주문없음)
TRADE_MODE=DRY
# REPAIR 모드에서만 유효: DIAGNOSTIC/REVERSE_AUDIT/REVERSE_RECONCILE/REVERSE_RESET/
# REVERSE_T_FIX/FENCE_CLEAR/NET_INVESTED_REPAIR/ASSUME_EXPIRY/REINFERENCE/FORCE_T
REPAIR_ACTION=
# shadow 누적은 scripts/shadow_runner.py 로컬 전용 실행 (GH Actions 미지원)
# SHADOW_FEE_RATE / SHADOW_SLIPPAGE_BPS — shadow_runner.py 참고

# ── T 보정 (1회성 — 사용 후 즉시 삭제) ──
FORCE_T_REINFERENCE=false
TQQQ_FORCE_T=
SOXL_FORCE_T=
TQQQ_MAX_T=
SOXL_MAX_T=

# ── 알림 ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
QUIET_HOURS=false

# ── 기타 ──
COMMISSION_RATE=0.0025
REINVEST=true
FINNHUB_API_KEY=
ORDER_HISTORY_VERBOSE=false
